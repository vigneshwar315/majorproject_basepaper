# Copy to .env and fill in LOCAL secrets. Never commit .env.
# Provider: gemini | openai | mock
LLM_PROVIDER=mock
# Model identifier. REQUIRED for gemini/openai. No default and no silent fallback.
# Find valid ids for your key with:  python -m paper_replication.cli list-models
LLM_MODEL=
GEMINI_API_KEY=
OPENAI_API_KEY=
# Optional tuning
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=3
# Leave LLM_TEMPERATURE unset to use the provider default (some models reject a temperature)
# LLM_TEMPERATURE=0
